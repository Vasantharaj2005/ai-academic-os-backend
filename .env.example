# Application
APP_NAME="AI Academic OS"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="ai_academic_os"

# Security
SECRET_KEY="dev-secret-key-change-in-prod"

# Redis (optional — server works without it)
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── LLM Provider Selection ─────────────────────────────────────────────────
# Options: auto | groq | gemini | openai | anthropic | mock
PRIMARY_PROVIDER="auto"

# ─── AI Keys ────────────────────────────────────────────────────────────────

# Groq  ✦ FREE | https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini  ✦ FREE | https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# OpenAI (optional fallback)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4-turbo-preview"

# Anthropic (optional fallback)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-opus-20240229"

# ─── Vector DB (optional) ───────────────────────────────────────────────────
# PINECONE_API_KEY=""
# PINECONE_ENVIRONMENT="gcp-starter"
# PINECONE_INDEX_NAME="academic-memory"